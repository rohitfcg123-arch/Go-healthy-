rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their own app backup.
    match /users/{userId}/private/{documentId} {
      allow read: if documentId == "appData" && request.auth != null
        && (request.auth.uid == userId
          || (request.auth.token.email == "rohit.fcg123@gmail.com"
            && request.auth.token.email_verified == true));
      allow write: if documentId == "appData" && request.auth != null
        && request.auth.uid == userId;
    }

    // Admin-only collection-group read for synced user records.
    // The portal uses this to list registered accounts and their synced smoking logs.
    match /{path=**}/private/{documentId} {
      allow read: if request.auth != null
        && request.auth.token.email == "rohit.fcg123@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Public app can read Help to Quit content; only the verified admin can edit it.
    match /siteContent/{documentId} {
      allow read: if documentId == "helpToQuit";
      allow create, update, delete: if documentId == "helpToQuit"
        && request.auth != null
        && request.auth.token.email == "rohit.fcg123@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Deny all other reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}